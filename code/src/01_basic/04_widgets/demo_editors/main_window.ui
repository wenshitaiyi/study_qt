       <layout class="QVBoxLayout" name="verticalLayoutTab3">
        <item>
         <widget class="QGroupBox" name="groupRichText">
          <property name="title">
           <string>【全服富文本公告编辑器 (QTextEdit 支持 HTML/格式工具栏)】</string>
          </property>
          <layout class="QVBoxLayout" name="verticalLayoutRich">
           <item>
            <layout class="QHBoxLayout" name="horizontalLayoutRichToolbar">
             <item>
