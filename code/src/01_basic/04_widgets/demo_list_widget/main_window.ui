      <!-- 避坑指南要点框 -->
      <item>
       <widget class="QGroupBox" name="groupPitfalls">
        <property name="title">
         <string>【核心避坑指南 (Gotchas)】</string>
        </property>
        <layout class="QVBoxLayout" name="vboxPitfalls">
         <item>
          <widget class="QLabel" name="labelPitfallNotes">
           <property name="styleSheet">
            <string notr="true">color: #7f8c8d; font-size: 11px;</string>
           </property>
           <property name="text">
            <string>1. takeItem(row) 仅从列表中解除关系，不会 delete 释放内存，必须显式 delete item！
2. customContextMenuRequested 信号传入的 pos 位于视口坐标系，弹窗必须使用 viewport()-&gt;mapToGlobal(pos) 换算。
3. 在代码中批量修改 item 文本时，务必调用 blockSignals(true/false) 防止 itemChanged 信号死循环递归。</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>

      <!-- 实时日志监控面板 -->
