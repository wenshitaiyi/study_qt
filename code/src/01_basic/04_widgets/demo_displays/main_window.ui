               </item>
               <item>
                <widget class="QPushButton" name="btnMoviePause">
                 <property name="text">
                  <string>⏸ 暂停</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="btnMovieSpeed">
                 <property name="text">
                  <string>⚡ 2.0x 倍速</string>
                 </property>
                </widget>
               </item>
              </layout>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- TAB 2: QProgressBar -->
      <widget class="QWidget" name="tabProgress">
       <attribute name="title">
        <string>2. 进度条与状态加载 (QProgressBar)</string>
