  </property>
  <property name="windowTitle">
   <string>Qt 常用展示控件与游戏界面实战 (demo_displays)</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="horizontalLayoutMain">
    <item>
     <widget class="QTabWidget" name="tabWidgetDisplays">
      <property name="currentIndex">
       <number>0</number>
      </property>

      <!-- TAB 1: QLabel -->
      <widget class="QWidget" name="tabLabel">
       <attribute name="title">
        <string>1. 图文展示与超链接 (QLabel / QMovie)</string>
       </attribute>
       <layout class="QVBoxLayout" name="verticalLayoutTab1">
        <item>
         <widget class="QGroupBox" name="groupHyperlink">
          <property name="title">
           <string>【富文本、HTML 排版与可点击游戏超链接】</string>
          </property>
          <layout class="QVBoxLayout" name="verticalLayoutRich">
           <item>
            <widget class="QLabel" name="labelRichLore">
             <property name="styleSheet">
              <string notr="true">background-color: #1e272e; color: #d2dae2; padding: 10px; border-radius: 6px; font-size: 13px;</string>
             </property>
             <property name="text">
              <string>&lt;h3 style='color:#f1c40f;'&gt;🗡️ 神兵纪元：灰烬使者 (Ashbringer)&lt;/h3&gt;
&lt;p&gt;在大领主莫格莱尼手中，这把神圣巨剑曾斩杀无数亡灵天灾军团。&lt;/p&gt;
&lt;p&gt;• 游戏内专属跳转：&lt;a href='item://2001' style='color:#3498db; font-weight:bold;'&gt;[🔍 查看神装全属性图鉴]&lt;/a&gt; | &lt;a href='quest://101' style='color:#e67e22; font-weight:bold;'&gt;[📜 接受【圣剑重铸】史诗任务]&lt;/a&gt;&lt;/p&gt;
&lt;p&gt;• 官方外链跳转：&lt;a href='https://www.qt.io' style='color:#2ecc71;'&gt;[🌐 访问艾泽拉斯官方公报站 (Qt Official)]&lt;/a&gt;&lt;/p&gt;</string>
             </property>
             <property name="textFormat">
              <enum>Qt::RichText</enum>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="openExternalLinks">
              <bool>false</bool>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="groupImageMovie">
          <property name="title">
           <string>【英雄立绘绘制 (QPixmap) 与技能光效动图 (QMovie)】</string>
          </property>
          <layout class="QHBoxLayout" name="horizontalLayoutImg">
           <item>
            <widget class="QLabel" name="labelHeroImage">
             <property name="minimumSize">
              <size>
               <width>220</width>
               <height>180</height>
              </size>
             </property>
             <property name="styleSheet">
              <string notr="true">background-color: #2c3e50; border: 2px solid #34495e; border-radius: 8px; color: #ecf0f1; font-weight: bold; qproperty-alignment: AlignCenter;</string>
             </property>
             <property name="text">
              <string>🛡️ 圣骑士立绘 (QPixmap)
[动态绘制渐变徽章背景]</string>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QVBoxLayout" name="verticalLayoutMovie">
             <item>
              <widget class="QLabel" name="labelMovieAnim">
               <property name="minimumSize">
                <size>
                 <width>200</width>
                 <height>120</height>
                </size>
               </property>
               <property name="styleSheet">
                <string notr="true">background-color: #000000; border: 1px solid #7f8c8d; border-radius: 6px; color: #e74c3c; font-size: 14px; font-weight: bold; qproperty-alignment: AlignCenter;</string>
               </property>
               <property name="text">
                <string>✨ 技能释放动态循环特效
(QMovie 帧动画播放中)</string>
               </property>
              </widget>
             </item>
             <item>
