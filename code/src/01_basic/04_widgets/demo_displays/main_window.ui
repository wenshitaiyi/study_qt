       </attribute>
       <layout class="QVBoxLayout" name="verticalLayoutTab3">
        <item>
         <widget class="QGroupBox" name="groupCountdown">
          <property name="title">
           <string>【副本限时通关倒计时 (QLCDNumber 仿真液晶钟表)】</string>
