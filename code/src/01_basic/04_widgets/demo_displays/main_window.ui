       <layout class="QVBoxLayout" name="vboxTab1">
        <item>
         <widget class="QGroupBox" name="groupRichLabel">
          <property name="title">
           <string>【QLabel 富文本与超链接】(setTextFormat &amp; linkActivated 信号)</string>
          </property>
          <layout class="QVBoxLayout" name="vboxRichLabel">
           <item>
            <widget class="QLabel" name="labelRichText">
             <property name="styleSheet">
              <string notr="true">background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: 10px; font-size: 13px;</string>
             </property>
             <property name="text">
              <string>&lt;h3 style='color:#2c3e50;'&gt;Qt 富文本与超链接跳转展示&lt;/h3&gt;
&lt;p&gt;QLabel 支持标准的 HTML/CSS 基础子集排版，支持自动换行与鼠标选中文本复制。&lt;/p&gt;
&lt;p&gt;• 内部自定义协议链接：&lt;a href='app://open-settings' style='color:#e67e22; font-weight:bold;'&gt;[打开系统设置弹窗 (app://open-settings)]&lt;/a&gt;&lt;/p&gt;
&lt;p&gt;• 外部网站链接：&lt;a href='https://doc.qt.io' style='color:#2980b9;'&gt;[访问 Qt 官方官方文档 (https://doc.qt.io)]&lt;/a&gt;&lt;/p&gt;</string>
             </property>
             <property name="textFormat">
              <enum>Qt::RichText</enum>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="textInteractionFlags">
              <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="groupImageMovie">
          <property name="title">
