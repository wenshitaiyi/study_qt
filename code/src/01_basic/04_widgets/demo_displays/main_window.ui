      <!-- TAB 4: Settlement Card -->
      <widget class="QWidget" name="tabCard">
       <attribute name="title">
        <string>4. 副本通关结算战报卡 (综合展示)</string>
       </attribute>
       <layout class="QVBoxLayout" name="verticalLayoutTab4">
