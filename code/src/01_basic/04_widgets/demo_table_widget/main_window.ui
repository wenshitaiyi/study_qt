      <!-- 避坑指南要点框 -->
      <item>
       <widget class="QGroupBox" name="groupPitfalls">
        <property name="title">
         <string>【QTableWidget 核心避坑指南 (Gotchas)】</string>
        </property>
        <layout class="QVBoxLayout" name="vboxPitfalls">
         <item>
          <widget class="QLabel" name="labelPitfallNotes">
           <property name="styleSheet">
            <string notr="true">color: #7f8c8d; font-size: 11px;</string>
           </property>
           <property name="text">
            <string>1. 数值科学排序避坑：必须使用 setData(Qt::DisplayRole, intValue) 存入数字型 QVariant，防止默认按字符串比较导致 '100' 排在 '20' 之前。
2. 批量刷表防卡顿：大批量插行前调用 setUpdatesEnabled(false)，完成后恢复 true，避免 UI 重复重绘卡死。
3. setCellWidget 开销：每个嵌入控件都是独立 QWidget，百行以内适合；海量数据建议用 QStyledItemDelegate。</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>

      <!-- 实时日志监控面板 -->
