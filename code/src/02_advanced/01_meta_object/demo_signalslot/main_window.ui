               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- Lambda 表达式组 -->
        <item>
         <widget class="QGroupBox" name="groupLambda">
          <property name="title">
           <string>【2. C++11 Lambda 表达式连接与上下文对象 (Context) 保护】</string>
          </property>
          <layout class="QVBoxLayout" name="vboxLambda">
           <item>
            <widget class="QLabel" name="labelLambdaDesc">
             <property name="text">
              <string>💡 核心知识点：connect(sender, &amp;sig, [=](){}) 缺少 context 对象时，若接收方被销毁，信号触发可能导致悬空指针野引用崩溃！推荐：connect(sender, &amp;sig, this, [=](){}) 由 Qt 自动管理上下文生命周期与线程调度。</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="hlayoutLambdaBtns">
             <item>
              <widget class="QPushButton" name="btnLambdaNoContext">
               <property name="text">
                <string>⚠️ 无 Context 对象的 Lambda (野指针风险)</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnLambdaWithContext">
               <property name="text">
                <string>🛡️ 带 Context (this) 的安全 Lambda</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- 句柄连接与单点断开 -->
