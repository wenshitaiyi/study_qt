        <!-- 1. 语法范式与 Lambda 保护 -->
        <item>
         <widget class="QGroupBox" name="groupSyntax">
          <property name="title">
           <string>1. 连接语法范式、二义性消除 (3种写法) 与 Lambda 保护</string>
          </property>
          <layout class="QGridLayout" name="gridSyntax">
           <item row="0" column="0">
            <widget class="QPushButton" name="btnQt4Syntax">
             <property name="text">
              <string>Qt4 宏语法: SIGNAL(...) / SLOT(...)</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QPushButton" name="btnQt5Syntax">
             <property name="text">
              <string>Qt5 函数指针语法: &amp;&amp;Sender::sig, &amp;&amp;Recv::slot</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0" colspan="2">
            <layout class="QHBoxLayout" name="hlayoutOverload">
             <item>
              <widget class="QLabel" name="labelOverload">
               <property name="text">
                <string>重载消歧义：</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QSpinBox" name="spinOverload">
               <property name="value">
                <number>42</number>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnOverloadQOverload">
               <property name="text">
                <string>QOverload&lt;int&gt;::of</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnOverloadqOverload">
               <property name="text">
                <string>qOverload&lt;int&gt; 宏</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnOverloadStaticCast">
               <property name="text">
                <string>static_cast&lt;void(*)(int)&gt;</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item row="2" column="0">
            <widget class="QPushButton" name="btnLambdaNoContext">
             <property name="text">
              <string>无 Context 的 Lambda (有野指针风险)</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QPushButton" name="btnLambdaWithContext">
             <property name="text">
              <string>带 Context (this) 的安全 Lambda</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <!-- 2. 信号联动、执行顺序、重复绑定与解绑大全 -->
        <item>
         <widget class="QGroupBox" name="groupBindingRules">
          <property name="title">
           <string>2. 信号联动转发、执行顺序 (FIFO)、防重绑定与解绑大全</string>
          </property>
          <layout class="QGridLayout" name="gridBinding">
           <item row="0" column="0">
            <widget class="QPushButton" name="btnTriggerSignalChain">
             <property name="text">
              <string>三级级联信号转发: Sig1 -&gt; Sig2 -&gt; Sig3 -&gt; 槽</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <layout class="QHBoxLayout" name="hlayoutOrder">
             <item>
              <widget class="QPushButton" name="btnConnectOrder123">
               <property name="text">
                <string>FIFO 顺序绑定 (1-&gt;2-&gt;3)</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnConnectOrder321">
               <property name="text">
                <string>FIFO 逆序绑定 (3-&gt;2-&gt;1)</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnTriggerOrderSignal">
               <property name="text">
                <string>发射检验顺序</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item row="1" column="0">
            <widget class="QPushButton" name="btnRepeatConnect3Times">
             <property name="text">
              <string>默认重复绑定 3 次 (发射触发 3 次)</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <layout class="QHBoxLayout" name="hlayoutUnique">
             <item>
              <widget class="QPushButton" name="btnUniqueConnect3Times">
               <property name="text">
                <string>Qt::UniqueConnection 唯一绑定</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnTriggerDupTestSignal">
               <property name="text">
                <string>发射检验触发次数</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item row="2" column="0">
            <widget class="QPushButton" name="btnDisconnectAllSender">
             <property name="text">
              <string>解绑发送者全部信号 (sender-&gt;disconnect())</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QPushButton" name="btnDisconnectSpecificSignal">
             <property name="text">
              <string>解绑指定信号所有槽 (disconnect(s, &amp;&amp;sig, 0, 0))</string>
             </property>
            </widget>
           </item>
           <item row="3" column="0">
            <widget class="QPushButton" name="btnDisconnectSpecificReceiver">
             <property name="text">
              <string>解绑指定接收者 (disconnect(s, 0, r, 0))</string>
             </property>
            </widget>
           </item>
           <item row="3" column="1">
            <widget class="QPushButton" name="btnDisconnectExactPair">
             <property name="text">
              <string>精准解绑单对 (disconnect(s, &amp;&amp;sig, r, &amp;&amp;slot))</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <!-- 3. 自定义类型与 void* 通用传递 -->
        <item>
