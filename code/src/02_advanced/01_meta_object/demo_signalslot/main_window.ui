       <layout class="QVBoxLayout" name="vboxSyntax">
        <!-- 语法演练组 -->
        <item>
         <widget class="QGroupBox" name="groupSyntax">
          <property name="title">
           <string>【1. Qt4 宏语法 vs Qt5 函数指针语法 vs 重载二义性消除 (3种写法)】</string>
