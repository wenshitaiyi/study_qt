      <!-- Tab 2: 信号联动、执行顺序、重复绑定与解绑大全 -->
      <widget class="QWidget" name="tabBindingRules">
       <attribute name="title">
        <string>🔗 联动、顺序、重复绑定与解绑</string>
       </attribute>
       <layout class="QVBoxLayout" name="vboxBindingRules">
        <!-- 信号与信号联动组 -->
        <item>
         <widget class="QGroupBox" name="groupSignalCascade">
          <property name="title">
           <string>【1. 信号与信号之间的联动转发 (Signal-to-Signal)】</string>
          </property>
          <layout class="QVBoxLayout" name="vboxSignalCascade">
           <item>
            <widget class="QLabel" name="labelCascadeDesc">
             <property name="text">
              <string>💡 信号转发链：connect(sig1, sig2) 使得发射 sig1 时自动级联发射 sig2，无需显式手写中间槽函数中转，常用于多层架构数据向上冒泡与模块扁平解耦。</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="hlayoutCascadeBtns">
             <item>
              <widget class="QPushButton" name="btnTriggerSignalChain">
               <property name="text">
                <string>⏩ 发射三级级联转发链: sigLevel1 -&gt; sigLevel2 -&gt; sigLevel3 -&gt; 槽函数</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- 绑定顺序与执行顺序组 -->
        <item>
         <widget class="QGroupBox" name="groupExecutionOrder">
          <property name="title">
           <string>【2. 绑定顺序与槽函数执行顺序 (FIFO 先入先出原则)】</string>
          </property>
          <layout class="QVBoxLayout" name="vboxOrder">
           <item>
            <widget class="QLabel" name="labelOrderDesc">
             <property name="text">
              <string>💡 核心规则：当一个信号绑定了多个槽函数时，Qt 在同线程下严格按照 connect 的先后顺序依次同步执行（FIFO 队列）。</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="hlayoutOrderBtns">
             <item>
              <widget class="QPushButton" name="btnConnectOrder123">
               <property name="text">
                <string>1️⃣ 顺序绑定 [槽A -&gt; 槽B -&gt; 槽C]</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnConnectOrder321">
               <property name="text">
                <string>2️⃣ 逆序绑定 [槽C -&gt; 槽B -&gt; 槽A]</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnTriggerOrderSignal">
               <property name="text">
                <string>🔔 发射信号检验执行顺序</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- 重复绑定问题组 -->
        <item>
         <widget class="QGroupBox" name="groupDuplicateConnect">
          <property name="title">
           <string>【3. 重复绑定问题与 Qt::UniqueConnection 唯一连接防重】</string>
          </property>
          <layout class="QVBoxLayout" name="vboxDup">
           <item>
            <widget class="QLabel" name="labelDupDesc">
             <property name="text">
              <string>⚠️ 重复绑定陷阱：Qt 默认允许同一对信号槽多次 connect，发射 1 次信号将触发 N 次槽函数（常见 Bug：在弹窗初始化或事件函数中反复 connect）！解决方案：使用 Qt::UniqueConnection 确保连接唯一性。</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="hlayoutDupBtns">
             <item>
              <widget class="QPushButton" name="btnRepeatConnect3Times">
               <property name="text">
                <string>⚠️ 默认模式重复绑定 3 次</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnUniqueConnect3Times">
               <property name="text">
                <string>🛡️ Qt::UniqueConnection 防重绑定 3 次</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnTriggerDupTestSignal">
               <property name="text">
                <string>🔔 发射测试信号观察触发次数</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- 解绑全景演示组 -->
        <item>
         <widget class="QGroupBox" name="groupDisconnectAll">
          <property name="title">
           <string>【4. 多维度解绑全解 (5 种 QObject::disconnect 形式)】</string>
          </property>
          <layout class="QGridLayout" name="gridDisconnectForms">
           <item row="0" column="0">
            <widget class="QPushButton" name="btnDisconnectAllSender">
             <property name="text">
              <string>1️⃣ 解绑发送者的全部信号与槽 (sender-&gt;disconnect())</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QPushButton" name="btnDisconnectSpecificSignal">
             <property name="text">
              <string>2️⃣ 解绑指定信号的所有槽 (disconnect(sender, &amp;sig, 0, 0))</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QPushButton" name="btnDisconnectSpecificReceiver">
             <property name="text">
              <string>3️⃣ 解绑特定接收者的所有槽 (disconnect(sender, 0, recv, 0))</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QPushButton" name="btnDisconnectExactPair">
             <property name="text">
              <string>4️⃣ 精准解绑单对信号与槽 (disconnect(s, &amp;sig, r, &amp;slot))</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <item>
         <spacer name="spacerBindingRules">
          <property name="orientation">
