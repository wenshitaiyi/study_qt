      <!-- Tab 3: 自定义类型与 void* 传递 -->
      <widget class="QWidget" name="tabCustomTypes">
       <attribute name="title">
        <string>📦 自定义类型与 void* 传递</string>
       </attribute>
       <layout class="QVBoxLayout" name="vboxCustomTypes">
        <!-- 自定义类型与 qRegisterMetaType 组 -->
        <item>
         <widget class="QGroupBox" name="groupCustomStruct">
          <property name="title">
           <string>【1. 跨线程 QueuedConnection 自定义结构体与 qRegisterMetaType】</string>
          </property>
          <layout class="QVBoxLayout" name="vboxCustomStruct">
           <item>
            <widget class="QLabel" name="labelCustomStructDesc">
             <property name="text">
              <string>💡 跨线程传递核心规则：同线程 DirectConnection 可以直接传递任意自定义类型；但跨线程 QueuedConnection 必须将参数深拷贝至事件队列，因此必须调用 qRegisterMetaType&lt;PlayerPacket&gt;(&quot;PlayerPacket&quot;)，且结构体必须具备默认构造、拷贝构造与析构函数！</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="hlayoutCustomStructBtns">
             <item>
              <widget class="QPushButton" name="btnRegisterMetaType">
               <property name="text">
                <string>1️⃣ 执行 qRegisterMetaType&lt;PlayerPacket&gt;() 注册</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnEmitCustomStructDirect">
               <property name="text">
                <string>2️⃣ 同线程 Direct 传递自定义结构体</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnEmitCustomStructQueued">
               <property name="text">
                <string>3️⃣ 跨线程 Queued 传递自定义结构体</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- void* 通用指针传递组 -->
        <item>
         <widget class="QGroupBox" name="groupVoidPointer">
          <property name="title">
           <string>【2. void* 通用泛型指针传递与内存所有权 (Ownership) 防坑】</string>
          </property>
          <layout class="QVBoxLayout" name="vboxVoid">
           <item>
            <widget class="QLabel" name="labelVoidDesc">
             <property name="text">
              <string>⚠️ void* 核心隐患：void* 仅传递内存地址。在跨线程 Queued 异步模式下，若发送者是在栈上分配或提早 delete，接收者执行时将访问悬空野指针发生段错误！正确规范：明确所有权协议（由接收者负责 delete，或改用智能指针 / QVariant 包装）。</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="hlayoutVoidBtns">
             <item>
              <widget class="QPushButton" name="btnEmitVoidPointerDirect">
               <property name="text">
                <string>1️⃣ 同线程发射 void* 指针 (reinterpret_cast 还原)</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnEmitVoidPointerAsyncSafe">
               <property name="text">
                <string>2️⃣ 跨线程堆内存 void* 传递 (转移所有权安全释放)</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <!-- QVariant 通用类型包装组 -->
        <item>
         <widget class="QGroupBox" name="groupQVariantWrap">
          <property name="title">
           <string>【3. QVariant 统一通用包装传递 (类型安全与解包)】</string>
          </property>
          <layout class="QVBoxLayout" name="vboxQVariantWrap">
           <item>
            <widget class="QLabel" name="labelVariantDesc">
             <property name="text">
              <string>💡 推荐的泛型传递解耦方案：通过 QVariant::fromValue(packet) 将自定义结构体包装为 QVariant。信号参数声明为 const QVariant&amp;，接收端通过 var.value&lt;PlayerPacket&gt;() 或 canConvert 安全解包，兼具动态通用性与内存安全性。</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="hlayoutVariantBtns">
             <item>
              <widget class="QPushButton" name="btnEmitQVariantWrapped">
               <property name="text">
                <string>🎁 发射 QVariant 包装的自定义类型</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>

        <item>
         <spacer name="spacerCustomTypes">
          <property name="orientation">
