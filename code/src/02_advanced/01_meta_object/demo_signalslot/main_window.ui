        <!-- 4. 5 种连接模式与跨线程交互 -->
        <item>
         <widget class="QGroupBox" name="groupThreading">
          <property name="title">
           <string>4. 5 种连接模式 (Qt::ConnectionType) 与跨线程 qApp 调度</string>
          </property>
          <layout class="QGridLayout" name="gridThreading">
           <item row="0" column="0">
            <widget class="QLabel" name="labelConnType">
             <property name="text">
              <string>连接模式：</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QComboBox" name="comboConnType">
             <item>
              <property name="text">
               <string>AutoConnection (同Direct/跨Queued)</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>DirectConnection (发射线程立即同步执行)</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>QueuedConnection (投递到接收线程事件队列)</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>BlockingQueuedConnection (阻塞等待/同线程死锁警告)</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>UniqueConnection (唯一连接防重复)</string>
              </property>
