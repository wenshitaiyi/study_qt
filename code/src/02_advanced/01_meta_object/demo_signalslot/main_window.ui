            <height>40</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>

      <!-- Tab 4: 5种连接类型与跨线程交互 -->
      <widget class="QWidget" name="tabThreading">
       <attribute name="title">
        <string>⚡ 5种连接类型与跨线程交互</string>
       </attribute>
       <layout class="QVBoxLayout" name="vboxThreading">
        <!-- 5种连接类型组 -->
        <item>
         <widget class="QGroupBox" name="groupConnTypes">
          <property name="title">
           <string>【1. Qt::ConnectionType 5 种连接机制演练】</string>
          </property>
          <layout class="QGridLayout" name="gridConnTypes">
           <item row="0" column="0">
            <widget class="QLabel" name="labelConnType">
             <property name="text">
              <string>选择连接类型：</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QComboBox" name="comboConnType">
             <item>
              <property name="text">
               <string>AutoConnection (同线程Direct/跨线程Queued)</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>DirectConnection (发射线程立即同步执行)</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>QueuedConnection (投递到接收者线程事件队列)</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>BlockingQueuedConnection (阻塞等待子线程/同线程死锁警告)</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>UniqueConnection (唯一连接防重复绑定)</string>
              </property>
             </item>
            </widget>
           </item>
           <item row="1" column="0" colspan="2">
            <layout class="QHBoxLayout" name="hlayoutThreadActions">
             <item>
              <widget class="QPushButton" name="btnStartWorkerThread">
               <property name="text">
                <string>🚀 启动后台工作线程 (测试当前连接类型)</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnTestBlockingQueue">
               <property name="text">
                <string>⏳ BlockingQueuedConnection 同步阻塞调用</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="labelPbar">
             <property name="text">
              <string>子线程运算进度：</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QProgressBar" name="pbarWorker">
             <property name="value">
              <number>0</number>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <!-- qApp 绑定与主线程切换 -->
        <item>
         <widget class="QGroupBox" name="groupQAppDispatch">
          <property name="title">
           <string>【2. qApp 绑定与 QMetaObject::invokeMethod 主线程无锁快速切换】</string>
          </property>
          <layout class="QVBoxLayout" name="vboxQApp">
           <item>
            <widget class="QLabel" name="labelQAppDesc">
             <property name="text">
              <string>💡 跨线程无侵入式切回主线程：在任意子线程或无 QObject 依赖的底层 C++ 线程中，调用 QMetaObject::invokeMethod(qApp, [=](){ ... }, Qt::QueuedConnection)，即可直接将代码块投递到主 UI 线程执行，安全更新界面控件！</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btnInvokeMethodQApp">
             <property name="text">
              <string>🎯 从独立异步 std::thread 中使用 invokeMethod(qApp) 极速切回主线程</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <item>
         <spacer name="spacerThreading">
          <property name="orientation">
           <enum>Qt::Vertical</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>20</width>
            <height>40</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>

      <!-- Tab 4: 自动命名绑定与高级特性 -->
      <widget class="QWidget" name="tabAdvanced">
       <attribute name="title">
        <string>🪄 自动命名绑定与高级特性</string>
       </attribute>
       <layout class="QVBoxLayout" name="vboxAdvanced">
        <!-- 自动绑定组 -->
        <item>
         <widget class="QGroupBox" name="groupAutoConnect">
          <property name="title">
           <string>【1. 界面规范自动绑定 (QMetaObject::connectSlotsByName)】</string>
          </property>
          <layout class="QVBoxLayout" name="vboxAuto">
           <item>
            <widget class="QLabel" name="labelAutoDesc">
             <property name="text">
              <string>💡 在 setupUi(this) 中会自动调用 QMetaObject::connectSlotsByName(this)，匹配 on_&lt;objectName&gt;_&lt;signalName&gt; 格式的槽函数实现无需手动 connect 的全自动绑定。</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btnAutoBound">
             <property name="text">
              <string>✨ 点击测试自动绑定的按钮 (on_btnAutoBound_clicked)</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <!-- 信号阻断与反射探测组 -->
        <item>
         <widget class="QGroupBox" name="groupAdvancedOps">
          <property name="title">
           <string>【2. blockSignals 信号阻断、sender() 触发源探测与 receivers 计数】</string>
          </property>
          <layout class="QGridLayout" name="gridAdvOps">
           <item row="0" column="0">
            <widget class="QCheckBox" name="chkBlockSignals">
             <property name="text">
              <string>🔇 启用 blockSignals(true) 静音信号</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QPushButton" name="btnTriggerBlocked">
             <property name="text">
              <string>🔔 发射测试信号 (测试阻断状态)</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QPushButton" name="btnCheckSender">
             <property name="text">
              <string>🕵️ sender() 获取发送者对象与局限性</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QPushButton" name="btnQueryReceivers">
             <property name="text">
              <string>📊 receivers(SIGNAL(...)) 查询连接槽数量</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <item>
         <spacer name="spacerAdvanced">
          <property name="orientation">
           <enum>Qt::Vertical</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>20</width>
            <height>40</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>
     </widget>
    </item>

    <!-- 右侧日志监控区 -->
    <item>
     <widget class="QGroupBox" name="groupLog">
      <property name="minimumSize">
       <size>
        <width>400</width>
        <height>0</height>
       </size>
      </property>
      <property name="title">
       <string>📡 信号与槽触发、调度与跨线程监控</string>
      </property>
      <layout class="QVBoxLayout" name="vboxLog">
       <item>
        <widget class="QPlainTextEdit" name="textLog">
         <property name="readOnly">
          <bool>true</bool>
         </property>
         <property name="font">
          <font>
           <family>Consolas</family>
           <pointsize>9</pointsize>
          </font>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnClearLog">
         <property name="text">
          <string>清空监控日志</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
   </layout>
  </widget>
 </widget>
 <resources/>
 <connections/>
</ui>
